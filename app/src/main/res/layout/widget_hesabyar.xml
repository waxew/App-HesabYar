<?xml version="1.0" encoding="utf-8"?>
<!-- Widget حسابیار: آخرین نتیجه + میانبر سه ابزار پرکاربرد. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حسابیار"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_last_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="آخرین نتیجه"
        android:textSize="12sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_last_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="-"
        android:textStyle="bold"
        android:textSize="16sp"
        android:gravity="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/widget_discount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تخفیف"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_profit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="سود"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_percent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="درصد"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
