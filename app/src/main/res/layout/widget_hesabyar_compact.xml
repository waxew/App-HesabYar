<?xml version="1.0" encoding="utf-8"?>
<!-- چیدمان فشرده Widget برای اندازه‌های کوچک‌تر. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حسابیار" android:textStyle="bold" android:textSize="15sp" android:gravity="end" />
    <TextView android:id="@+id/widget_last_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آخرین نتیجه" android:textSize="10sp" android:gravity="end" />
    <TextView android:id="@+id/widget_last_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="-" android:textStyle="bold" android:textSize="13sp" android:gravity="end" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
        <Button android:id="@+id/widget_discount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="٪-" android:textSize="10sp" />
        <Button android:id="@+id/widget_profit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="سود" android:textSize="10sp" />
        <Button android:id="@+id/widget_percent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="٪" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
