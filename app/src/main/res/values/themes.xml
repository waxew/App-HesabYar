<?xml version="1.0" encoding="utf-8"?>
<!-- Theme سطح Activity؛ رنگ‌های اصلی UI داخل Theme.kt و Material 3 مدیریت می‌شوند. -->
<resources>
    <!-- تم پایه بدون ActionBar چون TopAppBar در Compose ساخته می‌شود. -->
    <style name="Theme.HesabYar" parent="android:style/Theme.Material.Light.NoActionBar">
        <!-- نوار وضعیت شفاف است تا Edge-to-Edge به‌درستی نمایش داده شود. -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Navigation Bar نیز شفاف می‌ماند و Compose Insets را مدیریت می‌کند. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- جهت کلی برنامه از Locale و RTL پشتیبانی می‌کند. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
